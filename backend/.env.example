# Copy to backend/.env  (never commit the real .env)

# --- Provider ---------------------------------------------------------------
# Used only when a request does not choose a provider. A failing provider is
# never silently replaced by the other one.
DEFAULT_PROVIDER=ollama

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
OLLAMA_TIMEOUT=300

# Online AI (Gemini). Optional here: you can also paste the key in the app's
# Settings, which keeps it in backend memory only. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
# Model names change over time; check Google's current model list.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# --- Documents & retrieval ---------------------------------------------------
MAX_UPLOAD_MB=50
# "hf" = local sentence-transformers model (default). "hashing" = test-only fake embedder.
EMBEDDING_BACKEND=hf
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Evidence gate for grounded answers. Starting values for MiniLM; calibrate on your
# documents:  python -m scripts.calibrate_thresholds --docs ./docs --questions q.json
RETRIEVAL_MIN_SIMILARITY=0.30
RETRIEVAL_STRONG_SIMILARITY=0.55
EVIDENCE_MIN_TERM_COVERAGE=0.34

# --- Server -----------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO
